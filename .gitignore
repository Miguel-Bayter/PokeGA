# Prevent committing conflicting IDE settings
.settings/
.workspace/

# Prevent committing generated documentation (if any)
docs-generated/

# Prevent committing test coverage reports
coverage/

# Prevent committing build artifacts
artifacts/

# Prevent committing temporary migration files
prisma/migrations/*_migration/

# Prevent committing local development databases
*.sqlite
*.db

# Prevent committing environment-specific configs
config.local.*

# Prevent committing sensitive data
*.secret
*.password
*.credentials
